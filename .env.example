# ===== 模式 =====
# A = 所内 taker 秒开秒平（出量最快，每轮成本最高：taker费x2+点差x2）
# B = touch 挂单 + Lighter 对冲（maker 0 费，每轮成本低，出量慢；需配 Lighter API）
MODE=A

# ===== 每轮与风控 =====
NOTIONAL=10          # 每轮单边名义 $（起步别超过你亏得起的数）
INTERVAL=5           # A 模式轮间隔秒
VOL_STOP=0           # 双边累计量目标 $（到量自动停；0=不限）
KILL_USD=5           # 累计亏损 $ 停机线（建议本金的 1-2% 起步）
# ---- 以下仅 MODE=B ----
OFFSET_TICKS=0       # 挂单价离盘口几个 tick（0=贴盘口最激进；越大越便宜越难成交）
REQUOTE_BP=1.0       # 盘口偏离多少 bp 撤单重挂（太小=频繁撤挂，太大=挂着不动）
ORDER_TIMEOUT=120    # 挂单超时秒（超时撤单放弃本轮，防死等）

# ===== Hibachi 账户（app.hibachi.xyz）=====
HIBACHI_ACCOUNT_ID=
HIBACHI_API_KEY=
HIBACHI_PRIVATE_KEY=
HIBACHI_SYMBOL=BTC/USDT-P

# ===== Lighter 账户（MODE=B 才需要，app.lighter.xyz 设置/API 页）=====
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=
LIGHTER_MARKET_INDEX=1

# ===== 实盘开关（双开才真下单）=====
DRY_RUN=true
LIVE_TRADING_ACK=false
